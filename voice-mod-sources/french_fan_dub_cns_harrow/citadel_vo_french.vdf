"lang"
{
	"Tokens"
	{
		"bebop_ally_artist_killed_in_lane_01" "Ils ont éliminé le Peintre !"
		"bebop_ally_astro_killed_in_lane_01" "Holliday a été éliminée !"
		"bebop_ally_atlas_killed_in_lane_01" "Le détective a été éliminé !"
		"bebop_ally_baba_killed_in_lane_01" "Ils ont éliminé la Dame aux pigeons !"
		"bebop_ally_bookworm_killed_in_lane_01_alt" "Paige a été éliminée."
		"bebop_ally_chessmaster_killed_in_lane_01" "Ils ont éliminé le Joueur d'échecs !"
		"bebop_ally_chrono_killed_in_lane_01" "Paradox est morte !"
		"bebop_ally_deadpack_killed_in_lane_01" "Ils ont éliminé le Pilote d'essai !"
		"bebop_ally_doorman_killed_in_lane_01" "Portier a été éliminé !"
		"bebop_ally_drifter_killed_in_lane_01" "Rôdeur a été éliminé !"
		"bebop_ally_dynamo_killed_in_lane_01" "Dynamo a été éliminé."
		"bebop_ally_familiar_killed_in_lane_01" "Rem a été éliminé !"
		"bebop_ally_fencer_killed_in_lane_01" "Apollon a été éliminé !"
		"bebop_ally_forge_killed_in_lane_01" "McGinnis est K.O. !"
		"bebop_ally_ghost_killed_in_lane_01" "Dame Geist est K.O. !"
		"bebop_ally_gigawatt_killed_in_lane_01" "Seven a été éliminé !"
		"bebop_ally_haze_killed_in_lane_01" "Nébula a été éliminée."
		"bebop_ally_hornet_killed_in_lane_01" "Vindicta a été éliminée !"
		"bebop_ally_inferno_killed_in_lane_01" "Infernus est mort !"
		"bebop_ally_kelvin_killed_in_lane_01" "Kelvin a été éliminé."
		"bebop_ally_krill_killed_in_lane_01" "Minus a été éliminé."
		"bebop_ally_lash_killed_in_lane_01" "Cravache a été éliminé."
		"bebop_ally_lash_killed_in_lane_02" "Cravache a été éliminé… est-ce vraiment une mauvaise nouvelle ?"
		"bebop_ally_magician_killed_in_lane_01" "Sinclair a été éliminé !"
		"bebop_ally_mirage_killed_in_lane_01" "Mirage est K.O. !"
		"bebop_ally_nano_killed_in_lane_01" "Calico est K.O. !"
		"bebop_ally_nurse_killed_in_lane_01" "Ils ont éliminé l'Infirmière !"
		"bebop_ally_orion_killed_in_lane_01" "Serregrise a été éliminé !"
		"bebop_ally_priest_killed_in_lane_01" "Venator a été éliminé !"
		"bebop_ally_punkgoat_killed_in_lane_01" "Billy a été éliminé !"
		"bebop_ally_ratking_killed_in_lane_01" "Ils ont éliminé le Roi des rats !"
		"bebop_ally_shiv_killed_in_lane_01" "Surin a été éliminé."
		"bebop_ally_tengu_killed_in_lane_01" "Lyanne a été éliminée !"
		"bebop_ally_unicorn_killed_in_lane_01" "Céleste a été éliminée !"
		"bebop_ally_vampirebat_killed_in_lane_01" "Mina a été éliminée !"
		"bebop_ally_viper_killed_in_lane_01" "Vypère a été éliminée !"
		"bebop_ally_viscous_killed_in_lane_01" "Myxo a été éliminé."
		"bebop_ally_warden_killed_in_lane_01" "Marshal a été éliminé."
		"bebop_ally_warden_killed_in_lane_01_alt_01" "Ils ont éliminé Warden !"
		"bebop_ally_werewolf_killed_in_lane_01" "Silver a été éliminée !"
		"bebop_ally_wraith_killed_in_lane_01" "Scopa a été éliminée."
		"bebop_ally_yamato_killed_in_lane_01" "Yamato a été éliminée."
		"bebop_ap_reminder_01" "Je peux améliorer mes capacités."
		"bebop_ap_reminder_02" "Je peux travailler mes capacités."
		"bebop_ap_reminder_03" "Faut que je trouve du temps pour m'entraîner."
		"bebop_be_careful_01" "Je dois rester sur mes gardes."
		"bebop_be_careful_02" "Qui sait où se cache l'adversaire."
		"bebop_be_careful_03" "Je n'ai aucun renfort, je dois être prudent."
		"bebop_close_call_01" "Il va falloir qu'ils s'y prennent mieux que ça pour me tuer…"
		"bebop_close_call_02" "Je me suis sorti du pétrin…"
		"bebop_close_call_03" "Voilà qui devrait vous réveiller…"
		"bebop_close_call_04" "On a eu chaud."
		"bebop_close_call_05" "Ça a frôlé le désastre…"
		"bebop_end_streak" "Sa série de victimes s'arrête ici…"
		"bebop_hook_lands_01" "Par ici !"
		"bebop_hook_lands_02" "Approche-toi un peu !"
		"bebop_hook_lands_03" "Pas si vite !"
		"bebop_hook_lands_04" "Personne ne peut m'échapper…"
		"bebop_hook_lands_05" "C'est pas possible de m'échapper…"
		"bebop_hook_lands_06" "Qu'est-ce que tu fais là-bas !"
		"bebop_hook_lands_07" "Allez, viens faire connaissance avec mes potes !"
		"bebop_hook_lands_08" "Je le rapporte !"
		"bebop_hook_lands_09" "Bingo !"
		"bebop_hook_lands_10" "Viens dire bonjour…"
		"bebop_hunt_01" "Je vais te trouver…"
		"bebop_hunt_02" "Tu ne peux pas te cacher éternellement…"
		"bebop_hunt_03" "Sors et viens jouer avec moi…"
		"bebop_interrupt_01" "Pas question…"
		"bebop_interrupt_02" "C'est pas la peine d'essayer…"
		"bebop_interrupt_03" "C'est bien tenté…"
		"bebop_interrupt_04" "C'est pas ta journée…"
		"bebop_interrupt_05" "Tu es pile là où je veux…"
		"bebop_kill_anyhero_01" "Kaput."
		"bebop_kill_anyhero_02" "Et un de moins."
		"bebop_kill_anyhero_03" "*rires*"
		"bebop_kill_anyhero_04" "Ça me plait !"
		"bebop_kill_anyhero_05" "C'est le pied !"
		"bebop_kill_anyhero_06" "Je suis inarrêtable !"
		"bebop_kill_anyhero_07" "Je peux me battre contre n'importe qui !"
		"bebop_kill_anyhero_08" "Je suis le meilleur !"
		"bebop_kill_anyhero_09" "Tu veux te frotter à moi ?"
		"bebop_kill_anyhero_10" "Me cherche pas."
		"bebop_kill_astro_01" "Pas de chance, shérif."
		"bebop_kill_astro_02" "Vous n'aviez aucune chance contre moi, Holliday."
		"bebop_kill_astro_03" "J'ai fait ce que j'avais à faire."
		"bebop_kill_astro_04" "J'ai abattu la shérif."
		"bebop_kill_astro_05" "Elle n'aurait jamais dû me défier."
		"bebop_kill_atlas_01" "Désolé, détective."
		"bebop_kill_atlas_02" "Tu n'allais pas pouvoir m'arrêter, Abrams."
		"bebop_kill_atlas_03" "Personne ne m'empêchera d'aider Miss Shelly."
		"bebop_kill_atlas_04" "Le détective était coriace…"
		"bebop_kill_atlas_05" "Il s'est bien battu."
		"bebop_kill_bookworm_01" "Je parie que Miss Shelly l'aurait bien aimée."
		"bebop_kill_bookworm_02" "J'ai abattu leur soutien."
		"bebop_kill_bookworm_03" "Grande imagination, mais guerrier médiocre."
		"bebop_kill_bookworm_04" "J'ai coupé le sifflet à la conteuse."
		"bebop_kill_bookworm_05" "Elle ne protègera pas ses partenaires de sitôt."
		"bebop_kill_chrono_01" "La voleuse de temps est hors d'état de nuire."
		"bebop_kill_chrono_02" "Nous n'avons plus à nous soucier de Paradox pour le moment…"
		"bebop_kill_chrono_03" "Ça aurait pu être pire…"
		"bebop_kill_chrono_04" "Paradox, nous ne sommes pas au même niveau."
		"bebop_kill_chrono_05" "Tu n'as jamais affronté quelqu'un comme moi, Paradox."
		"bebop_kill_doorman_01" "Ce n'était pas un portier ordinaire."
		"bebop_kill_doorman_02" "Il faut que je pense à annuler le brunch de Miss Shelly à l'hôtel Baroness."
		"bebop_kill_doorman_03" "Plus de tours de passepasse, portier."
		"bebop_kill_doorman_04" "Contente-toi d'ouvrir des portes."
		"bebop_kill_doorman_05" "Le portier est hors d'état de nuire."
		"bebop_kill_drifter_01" "J'ai éliminé Rôdeur."
		"bebop_kill_drifter_02" "Je ne suis pas une proie facile, Rôdeur."
		"bebop_kill_drifter_03" "De quoi j'ai l'air, Rôdeur ? D'une fragile créature organique ?"
		"bebop_kill_drifter_04" "Cravache était plus coriace."
		"bebop_kill_drifter_05" "Cette bestiole était maléfique."
		"bebop_kill_dynamo_01" "Dynamo est K.O. !"
		"bebop_kill_dynamo_02" "Le professeur n'est plus une menace."
		"bebop_kill_dynamo_03" "Vous avez choisi la mauvaise équipe, Dynamo…"
		"bebop_kill_dynamo_04" "Fini les trous noirs, Professeur."
		"bebop_kill_dynamo_05" "J'aurais aimé combattre à tes côtés, Dynamo."
		"bebop_kill_familiar_01" "Je crois pas que Miss Shelly approuverait ce coup-là."
		"bebop_kill_familiar_02" "Ce petit gars avait pas la moindre chance."
		"bebop_kill_familiar_03" "C'était quoi ce truc ?"
		"bebop_kill_familiar_04" "J'ai abattu Rem."
		"bebop_kill_familiar_05" "Ah non, désolé Rem, les siestes, c'est pas mon truc."
		"bebop_kill_fencer_01" "Eh ben, il en faisait des tonnes."
		"bebop_kill_fencer_02" "Il a l'ego de Cravache, mais pas son talent."
		"bebop_kill_fencer_03" "On dirait que ton école de rupins t'a jamais appris à gagner un combat."
		"bebop_kill_fencer_04" "Un tournoi d'escrime au lycée, c'est pas un vrai combat, Apollon."
		"bebop_kill_fencer_05" "T'es venu affronter un golem avec une épée. T'es moins malin que je pensais."
		"bebop_kill_forge_01" "Dommage qu'elle ne travaille pas avec nous."
		"bebop_kill_forge_02" "Fairfax Industries se retrouve sans ingénieur."
		"bebop_kill_forge_03" "Je parie qu'elle aurait pu me faire une petite révision…"
		"bebop_kill_forge_04" "Et moi qui voulais qu'elle parle à Miss Shelly…"
		"bebop_kill_forge_05" "Nous ne sommes pas près d'être dérangés par McGinnis."
		"bebop_kill_gigawatt_03" "Tu seras gentil d'aller lancer la foudre ailleurs…"
		"bebop_kill_haze_01" "Nébula est K.O. !"
		"bebop_kill_haze_05" "Tu es douée Nébula, mais tu pas autant que moi."
		"bebop_kill_high_networth" "Peu importe leur taille, je règlerai leurs comptes…"
		"bebop_kill_kelvin_01" "Kelvin est K.O. !"
		"bebop_kill_kelvin_02" "Ton rayon de congélation n'allait jamais suffire, mon pote."
		"bebop_kill_kelvin_03" "Kelvin, tu étais au mauvais endroit, au mauvais moment."
		"bebop_kill_kelvin_04" "Rien de personnel, Kelvin… mais tu devais y passer."
		"bebop_kill_kelvin_05" "Le spectre de glace est mort."
		"bebop_kill_krill_01" "J'ai abattu Miro et Minus !"
		"bebop_kill_krill_02" "Les taupes sont K.O. !"
		"bebop_kill_krill_03" "Les nuisibles des tunnels ont été éliminés."
		"bebop_kill_krill_04" "Vous êtes coriaces tous les deux, mais ça ne suffira pas."
		"bebop_kill_krill_05" "Je les ai eus, ces fumiers…"
		"bebop_kill_lash_01" "Je te surpasse, Cravache. Va falloir t'y faire."
		"bebop_kill_lash_02" "Vous avez vu ? C'est moi qui ai eu Cravache. Moi. J'ai. Descendu. Cravache."
		"bebop_kill_lash_03" "Je te l'avais dit, Cravache… la dernière fois, t'as juste eu de la chance."
		"bebop_kill_lash_04" "J'ai remis Cravache à sa place."
		"bebop_kill_lash_05" "Cravache fait moins le malin, maintenant…"
		"bebop_kill_nano_01" "J'ai éliminé Calico."
		"bebop_kill_nano_02" "Tu ne nous arrêteras pas, Calico."
		"bebop_kill_nano_03" "Je ne suis pas une de ces créatures organiques faciles à tuer."
		"bebop_kill_nano_04" "Calico, ton arrogance t'a couté cher."
		"bebop_kill_nano_05" "Tu devrais le savoir quand tu ne fais pas le poids, Calico."
		"bebop_kill_necro_01" "J'ai éliminé le nécromancien."
		"bebop_kill_necro_02" "Laisse les morts tranquilles, Tombale."
		"bebop_kill_necro_03" "Cette fille était flippante."
		"bebop_kill_necro_04" "Cette fille a besoin d'un câlin de ses parents."
		"bebop_kill_necro_05" "Je me suis occupé de Tombale."
		"bebop_kill_orion_02" "T'as passé l'âge des vendettas, non ?"
		"bebop_kill_priest_01" "C'est pas ton jour, Venator."
		"bebop_kill_priest_02" "C'en est fini des Venators."
		"bebop_kill_priest_03" "Rien de personnel, Venator."
		"bebop_kill_priest_04" "Hors de mon chemin."
		"bebop_kill_priest_05" "Vous ne m'arrêterez pas, Venator."
		"bebop_kill_punkgoat_01" "Quel triste petit humain."
		"bebop_kill_punkgoat_02" "J'ai abattu une chèvre."
		"bebop_kill_punkgoat_03" "On aurait dit une copie discount de Cravache."
		"bebop_kill_punkgoat_04" "Les types dans son genre me fatiguent."
		"bebop_kill_punkgoat_05" "Quel misérable personnage."
		"bebop_kill_shiv_01" "Surin est K.O. !"
		"bebop_kill_shiv_02" "Tes couteaux n'auraient jamais suffi."
		"bebop_kill_shiv_03" "Passe moins de temps à te coiffer et plus de temps à t'entrainer."
		"bebop_kill_shiv_04" "Ce n'est pas ta journée, Surin."
		"bebop_kill_shiv_05" "Il y a toujours plus coriace que soi, Surin. N'oublie jamais ça."
		"bebop_kill_unicorn_01" "J'ai eu Celeste !"
		"bebop_kill_unicorn_02" "Elle était plus coriace qu'elle en avait l'air."
		"bebop_kill_unicorn_03" "Elle manquait pas de couleurs, celle-là."
		"bebop_kill_unicorn_04" "Elle avait un grand cœur, mais ça a pas suffi."
		"bebop_kill_unicorn_05" "Tu sais, je commence à croire que c'est vraiment une licorne."
		"bebop_kill_vampirebat_01" "J'ai éliminé la vampire."
		"bebop_kill_vampirebat_02" "J'ai réglé son compte à Mina."
		"bebop_kill_vampirebat_03" "Il y a toujours quelqu'un de meilleur que toi, Mina."
		"bebop_kill_vampirebat_04" "Un peu d'humilité lui ferait le plus grand bien."
		"bebop_kill_vampirebat_05" "Mina, tu n'étais pas prête à affronter quelqu'un comme moi."
		"bebop_kill_viper_01" "Quelle créature odieuse."
		"bebop_kill_viper_02" "Quelle femme odieuse…"
		"bebop_kill_viper_03" "J'ai éliminé Vypère."
		"bebop_kill_viper_04" "Bon sang, elle est insupportable."
		"bebop_kill_viper_05" "J'arrive pas à croire qu'elle ait survécu aussi longtemps sans finir poignardée et abandonnée dans un caniveau."
		"bebop_kill_viscous_01" "Retourne donc dans les Profondeurs, veux-tu ?"
		"bebop_kill_viscous_02" "Myxo est K.O. !"
		"bebop_kill_viscous_03" "J'ai réglé son compte au gamin visqueux !"
		"bebop_kill_viscous_04" "Ton cube n'allait jamais te sauver."
		"bebop_kill_viscous_05" "Myxo ne va plus nous déranger pendant un bon moment…"
		"bebop_kill_warden_01" "J'ai arrêté Marshal…"
		"bebop_kill_warden_02" "Je garde Marshal sous contrôle…"
		"bebop_kill_warden_03" "Ta petite révolution s'arrête ici…"
		"bebop_kill_warden_04" "Marshal est K.O. !"
		"bebop_kill_warden_05" "J'ai éliminé Marshal !"
		"bebop_kill_werewolf_01" "Elle s'est sacrément bien battue."
		"bebop_kill_werewolf_02" "J'ai éliminé Silver !"
		"bebop_kill_werewolf_03" "C'est pas la première fois que je colle une raclée à un loup-garou."
		"bebop_kill_werewolf_04" "J'ai affronté plus coriace dans la fosse aux ours."
		"bebop_kill_werewolf_05" "Je me suis occupé du loup-garou."
		"bebop_kill_wraith_04" "J'ai éliminé Scopa !"
		"bebop_kill_wraith_05" "Scopa est K.O. !"
		"bebop_kill_yamato_02" "Yamato est K.O. !"
		"bebop_kill_yamato_03" "J'ai abattu Yamato…"
		"bebop_kill_yamato_04" "Fais-toi harakiri, Yamato… qu'on gagne du temps."
		"bebop_kill_yamato_05" "Je ne vais pas me faire découper par des excentriques en ton genre !"
		"bebop_last_one_standing_01" "Évidemment que je leur ai tous survécu…"
		"bebop_last_one_standing_02" "Pas facile de se faire aider efficacement, hein…"
		"bebop_last_one_standing_03" "Au final, y a plus que moi qui tiens encore debout…"
		"bebop_low_health_warning" "On ferait peut-être mieux de reculer un peu…"
		"bebop_melee_kill_01" "Je t'ai eu !"
		"bebop_melee_kill_02" "C'est fini, l'ami."
		"bebop_melee_kill_03" "T'aurais jamais dû t'approcher de moi…"
		"bebop_melee_kill_04" "Rien de tel qu'une bonne salade de phalanges pour faire monter la pression sanguine (façon de parler…)"
		"bebop_melee_kill_05" "Fastoche."
		"bebop_near_miss_01" "Reviens te battre !"
		"bebop_near_miss_02" "Reviens là !"
		"bebop_near_miss_03" "T'as raison, décampe !"
		"bebop_near_miss_04" "Tu vas y passer !"
		"bebop_near_miss_05" "Bon sang, ils se sont échappés."
		"bebop_outnumbered_01" "Ils sont peut-être trop nombreux…"
		"bebop_outnumbered_02" "Pas la peine de risquer ma peau…"
		"bebop_outnumbered_03" "Je devrais peut-être rejoindre les autres…"
		"bebop_parry_01" "S'il vous plait…"
		"bebop_parry_02" "Tu ne me toucheras plus jamais…"
		"bebop_parry_03" "Tu as cherché les problèmes, et tu les as trouvés…"
		"bebop_ping_pre_game_01" "Pas d'inquiétude, Miss Shelly. Je ne vous décevrais pas."
		"bebop_ping_pre_game_02" "Pour ma part, j'ai hâte de prouver que je suis meilleur que Cravache."
		"bebop_ping_pre_game_03" "Reste près de moi, je vais nous attirer des ennuis."
		"bebop_ping_pre_game_04" "Je n'ai pas été conçu pour combattre, mais je suis sacrément doué."
		"bebop_ping_pre_game_05" "Miss Shelly n'approuverait sans doute pas ce que je m'apprête à faire… malheureusement pour eux, elle est à la maison en train de se reposer."
		"bebop_ping_pre_game_06" "J'ai attendu ce moment…"
		"bebop_revenge_kill" "Tu pensais en avoir fini avec moi, hein ?"
		"bebop_select_01" "Ma créatrice a besoin de mon aide, et je ne la laisserai pas tomber."
		"bebop_select_02" "Je ferai tout ce qu'il faut pour sauver Miss Shelly."
		"bebop_select_03" "Miss Shelly a le cœur droit. Elle ne verrait probablement pas d'un bon œil que je prenne part à des combats sanglants pour quelques billets. Moi, en revanche, affranchi des scrupules humains, j'y vois une manière fort divertissante d'occuper mon temps."
		"bebop_select_04" "Miss Shelly fait une sieste. Ça devrait me laisser assez de temps pour contacter une créature divine."
		"bebop_select_05" "On se méprend complètement sur moi… La violence pour la violence ne m'intéresse pas. Ce qui m'intéresse, c'est la violence pour l'argent."
		"bebop_select_06" "Un peu de grabuge n'a jamais fait de mal à personne…"
		"bebop_select_07" "Frapper Cravache au visage me parait la seule façon d'améliorer cette journée."
		"bebop_select_08" "Prêt à aller semer la pagaille avec mes potes."
		"bebop_select_09" "Qui veut jouer avec tonton Bebop ?"
		"bebop_select_10" "M'affronter sera leur dernière erreur."
		"bebop_unselect_01" "Désolé, faut que je retourne à la casse."
		"bebop_unselect_02" "Parfait. Ça me laisse plus de temps pour trouver de nouvelles façons de faire souffrir Cravache."
		"bebop_unselect_03" "Je peux pas. Miss Shelly a besoin de mon aide."
		"bebop_unselect_04" "C'est toi qui vois."
		"bebop_unselect_05" "Promets-moi juste de pas faire équipe avec Cravache…"
		"bebop_unselect_06" "J'aurais pas fait ce choix, mais bon, c'est ta vie…"
		"bebop_unselect_07" "Miss Shelly est en forme aujourd'hui, alors je vais passer du temps avec elle tant que je peux."
		"bebop_unselect_08" "Tu tombes plutôt mal, mon pote."
		"bebop_unselect_09" "Y a du boulot à la casse."
		"bebop_unselect_10" "Tu te débrouilleras sans moi. Mais Miss Shelly ? Elle a besoin de moi."
		"bebop_use_ability_refresher_01" "Je rembobine !"
		"bebop_use_ability_refresher_02" "L'hyperlaser est prêt."
		"bebop_use_ability_refresher_03" "Rechargé et paré au combat."
		"bebop_use_colossus_01" "Colosse !"
		"bebop_use_colossus_02" "Je vous aurai, tous autant que vous êtes."
		"bebop_use_colossus_03" "À qui le tour ?"
		"bebop_use_curse_01" "Malédiction !"
		"bebop_use_curse_02" "Ils sont maudits !"
		"bebop_use_curse_03" "Je vais les maudire."
		"bebop_use_decay_01" "Décomposition."
		"bebop_use_decay_02" "Je vais les avoir à l'usure."
		"bebop_use_decay_03" "Je vais ralentir leurs soins."
		"bebop_use_echo_shard_01" "Éclat d'écho !"
		"bebop_use_echo_shard_02" "J'ai repris des forces."
		"bebop_use_echo_shard_03" "On y retourne…"
		"bebop_use_hook_01" "J'envoie le grappin !"
		"bebop_use_hook_02" "Je les accroche !"
		"bebop_use_hook_03" "Je vais les attraper !"
		"bebop_use_hook_04" "Je lance le grappin !"
		"bebop_use_hook_05" "Je tire le grappin !"
		"bebop_use_hook_06" "Je les vois… !"
		"bebop_use_hook_07" "Ha ha !"
		"bebop_use_hook_07_02" "Ha ha !"
		"bebop_use_hook_08" "Je vais les ramener !"
		"bebop_use_hook_09" "Les voilà !"
		"bebop_use_hook_10" "Grappin lancé !"
		"bebop_use_ice_blast_01" "Explosion de glace !"
		"bebop_use_ice_blast_02" "J'invoque la glace !"
		"bebop_use_ice_blast_03" "J'envoie la glace !"
		"bebop_use_metal_skin_01" "Cuir blindé !"
		"bebop_use_metal_skin_02" "Les balles ne m'inquiètent pas."
		"bebop_use_metal_skin_03" "Tirez-moi dessus autant que vous le voulez…"
		"bebop_use_phantom_strike_01" "Frappe spectrale !"
		"bebop_use_phantom_strike_02" "Je me téléporte."
		"bebop_use_phantom_strike_03" "Il est temps de dire bonjour…"
		"bebop_use_shadow_weave_01" "Tissage d'ombres…"
		"bebop_use_shadow_weave_02" "Ils ne me verront pas…"
		"bebop_use_shadow_weave_03" "C'est le moment de les prendre par surprise."
		"bebop_use_silencer_01" "Ils ne vont plus pouvoir utiliser leurs petits tours bien longtemps…"
		"bebop_use_silencer_02" "Laisse-moi m'occuper de leur magie…"
		"bebop_use_silencer_03" "Leurs capacités ne leur serviront à rien…"
		"bebop_use_surging_power_01" "Puissance croissante !"
		"bebop_use_surging_power_02" "Prêt à décharger !"
		"bebop_use_surging_power_03" "Il est temps d'être impitoyable !"
		"bebop_use_tech_purge_01" "Purge en cours !"
		"bebop_use_tech_purge_02" "Je tiendrai bon…"
		"bebop_use_tech_purge_03" "Allez, ça va passer…"
		"bebop_use_unstoppable_01" "Personne ne peut m'arrêter !"
		"bebop_use_unstoppable_02" "La magie ne peut pas m'arrêter !"
		"bebop_use_unstoppable_03" "Leurs capacités ne me font pas peur."
		"bebop_use_vampiric_burst_01" "Explosion vampirique."
		"bebop_use_vampiric_burst_02" "Prêt à ouvrir le feu."
		"bebop_use_vampiric_burst_03" "C'est l'heure de foncer dans le tas."
		"doorman_killstreak_high_01" "Cela fait des années que je n'avais pas massacré autant d'humains. Quel plaisir !"
		"doorman_killstreak_high_02" "Mortels, vos vies insignifiantes vont bientôt prendre fin."
		"doorman_killstreak_high_03" "Vous ne comprenez donc pas, imbéciles ? C'est ma colère que vous devriez craindre, pas celle du Patron."
		"doorman_killstreak_mid_01" "J'avais oublié à quel point il est délicieux d'être craint."
		"doorman_killstreak_mid_02" "Si vous vous rendez maintenant, je vous offre une nuit gratuite au Baroness…"
		"doorman_killstreak_mid_03" "Il vous reste peu de temps pour éviter d'être égorgés comme des agneaux. Rendez-vous."
		"doorman_killstreak_start_01" "Les vieilles habitudes ont la vie dure, j'en ai peur."
		"doorman_killstreak_start_02" "Puisque j'en suis arrivé là, autant tous les tuer, je suppose…"
		"doorman_killstreak_start_03" "Je vois que ce sera une journée de violence."
		"doorman_killstreak_start_04" "Infliger gratuitement de la violence est bien plus simple que dans mes souvenirs."
		"doorman_killstreak_start_05" "À terme, je vous massacrerai tous."
		"doorman_leave_base_01" "Il est temps d'achever le rituel."
		"doorman_leave_base_02" "Le Patron sera invoqué."
		"doorman_leave_base_03" "Et maintenant, écrasons-les comme des fourmis."
		"doorman_leave_base_04" "C'est le début de la fin."
		"doorman_leave_base_05" "Notre victoire est à portée de main."
		"doorman_ping_pre_game_01" "Vous savez, vous n'êtes pas obligé d'accomplir le rituel ; pourquoi ne pas plutôt venir passer la journée au spa de l'hôtel Baroness ?"
		"doorman_ping_pre_game_02" "Plus vite nous terminerons le rituel, plus vite je pourrai reprendre mes fonctions au Baroness."
		"doorman_ping_pre_game_03" "Quel plaisir de revoir la Mère de la Ville et le Roi d'Ambre."
		"doorman_ping_pre_game_04" "Un délicieux brunch se tient en ce moment même au Baroness."
		"doorman_ping_pre_game_05" "Pour ma part, je trouve nos chances plutôt bonnes."
		"doorman_ping_pre_game_06" "Je me réjouis de vous aider, vous autres mortels, à enrichir vos vies insignifiantes."
		"doorman_select_01" "Je suis à votre service."
		"doorman_select_02" "C'est un honneur d'être à votre disposition."
		"doorman_select_03" "Vous constaterez que le service au Baroness est… exemplaire."
		"doorman_select_04" "Je trouve que la perception et la réalité se rejoignent bien moins qu'on ne le croit."
		"doorman_select_05" "Puisse votre passage à New York être inoubliable."
		"doorman_select_06" "Si, après le rituel, vous souhaitez des billets pour South Pacific, n'hésitez pas à demander."
		"doorman_select_06_alt_01" "Après le rituel, si vous souhaitez des billets pour South Pacific, n'hésitez pas à demander."
		"doorman_select_07" "Au Baroness, nous visons toujours la perfection."
		"doorman_select_08" "Aujourd'hui sera une journée sans pareille, je vous l'assure."
		"doorman_select_09" "New York est un endroit fascinant, n'est-ce pas ? On ne sait jamais sur qui l'on va tomber…"
		"doorman_select_10" "Il est important de ne jamais sous-estimer le personnel."
		"doorman_unselect_01" "J'ai bien peur que le travail d'un portier ne soit jamais terminé."
		"doorman_unselect_02" "Hélas, mes obligations au Baroness me retiennent aujourd'hui."
		"doorman_unselect_03" "Malheureusement, les clients du Baroness réclament mon attention."
		"doorman_unselect_04" "Je pense qu'aujourd'hui, je resterai simplement un humble portier."
		"doorman_unselect_05" "Revenez nous voir."
		"doorman_unselect_06" "Quand vous aurez besoin de moi, je serai prêt."
		"doorman_unselect_07" "Le Baroness vous ouvrira volontiers ses portes si vous le souhaitez."
		"doorman_unselect_08" "Bonne chance avec les Patrons aujourd'hui."
		"doorman_unselect_09" "Je ne ressens pas le besoin de me mêler à la petite querelle des Patrons."
		"doorman_unselect_10" "Après le rituel, passez donc à notre salon. Francis prépare un excellent martini."
		"doorman_use_ability_refresher_01" "Ils entendront l'appel du Baroness."
		"doorman_use_ability_refresher_02" "Prêt à accueillir un autre convive."
		"doorman_use_ability_refresher_03" "L'appel du Baroness résonne aux confins du cosmos."
		"doorman_use_colossus_01" "Colosse !"
		"doorman_use_colossus_02" "<rires>"
		"doorman_use_colossus_03" "Je les réduirai en miettes, comme les fourmis qu'ils sont."
		"doorman_use_curse_01" "Malédiction !"
		"doorman_use_curse_02" "Ils sont maudits !"
		"doorman_use_curse_03" "Je les maudis !"
		"doorman_use_decay_01" "Décomposition !"
		"doorman_use_decay_02" "Que vous pourrissiez de l'intérieur…"
		"doorman_use_decay_03" "L'heure de la souffrance est arrivée."
		"doorman_use_echo_shard_01" "Éclat d'écho !"
		"doorman_use_echo_shard_02" "Mes capacités sont de retour."
		"doorman_use_echo_shard_03" "Je suis tout-puissant."
		"doorman_use_ice_blast_01" "Explosion de glace !"
		"doorman_use_ice_blast_02" "Irradiant de froid."
		"doorman_use_ice_blast_03" "Souffle glacial !"
		"doorman_use_metal_skin_01" "Cuir blindé !"
		"doorman_use_metal_skin_02" "Blindé à bloc !"
		"doorman_use_metal_skin_03" "Que peuvent bien des balles contre un dieu ?"
		"doorman_use_phantom_strike_01" "Frappe spectrale !"
		"doorman_use_phantom_strike_02" "Téléportation !"
		"doorman_use_phantom_strike_03" "Vous voilà…"
		"doorman_use_shadow_weave_01" "Tissage d'ombres."
		"doorman_use_shadow_weave_02" "Je me fonds dans l'ombre…"
		"doorman_use_shadow_weave_03" "À très bientôt…"
		"doorman_use_tech_purge_01" "Purge en cours."
		"doorman_use_tech_purge_02" "Parfait…"
		"doorman_use_tech_purge_03" "Aaah…"
		"doorman_use_unstoppable_01" "Personne ne m'arrête !"
		"doorman_use_unstoppable_02" "Ta magie est sans effet sur moi."
		"doorman_use_unstoppable_03" "Ton pouvoir ne m'effraie pas."
		"doorman_use_vampiric_burst_01" "Explosion vampirique !"
		"doorman_use_vampiric_burst_02" "Que leur souffrance me nourrisse."
		"doorman_use_vampiric_burst_03" "Je vais guérir et ils mourront."
		"gigawatt_angry_01" "Vous allez payer !"
		"gigawatt_angry_02" "Tuez-les !"
		"gigawatt_angry_03" "Anéantissez-les !"
		"gigawatt_angry_04" "Ça va être un massacre…"
		"gigawatt_angry_05" "Vous êtes tous morts !"
		"gigawatt_angry_06" "Personne ne survivra !"
		"gigawatt_angry_07" "Vous n'avez aucune chance !"
		"gigawatt_angry_08" "Vous regretterez d'être venus !"
		"gigawatt_angry_09" "Vous allez souffrir !"
		"gigawatt_angry_10" "Je vous ferai supplier !"
		"gigawatt_ap_reminder_01" "Je peux améliorer mes pouvoirs."
		"gigawatt_ap_reminder_02" "Mes pouvoirs sont prêts à être améliorés."
		"gigawatt_ap_reminder_03" "Je ne dois pas oublier d'améliorer mes capacités."
		"gigawatt_be_careful_01" "Je suis exposé ici."
		"gigawatt_be_careful_02" "Je n'ai pas de renfort, j'ai intérêt à être prudent."
		"gigawatt_be_careful_03" "Je dois penser à rester en contact avec les autres."
		"gigawatt_close_call_01" "Pas aujourd'hui, non."
		"gigawatt_close_call_02" "Je leur ai glissé entre les doigts."
		"gigawatt_close_call_03" "Je me déjouerai de la mort."
		"gigawatt_close_call_04" "Ça aurait pu mal tourner…"
		"gigawatt_close_call_05" "Leur meilleur niveau n'était pas assez bon."
		"gigawatt_congrats_01" "Bon boulot."
		"gigawatt_congrats_02" "On les a éliminés !"
		"gigawatt_congrats_03" "Nous sommes une équipe bien rodée."
		"gigawatt_congrats_04" "Et VOILÀ comment on élimine un obstacle."
		"gigawatt_congrats_05" "Quel plaisir de se faire aider efficacement."
		"gigawatt_desperation_power1_01" "Foudre !"
		"gigawatt_desperation_power1_02" "Je vais vous carboniser…"
		"gigawatt_desperation_power1_03" "Meurs !"
		"gigawatt_desperation_power1_04" "Que la foudre s'abatte sur vous !"
		"gigawatt_desperation_power1_05" "Je ne cèderai pas !"
		"gigawatt_desperation_power2_01" "Je les marque…"
		"gigawatt_desperation_power2_02" "Tu es à moi maintenant…"
		"gigawatt_desperation_power2_03" "Je t'ai pris au piège."
		"gigawatt_desperation_power2_04" "L'oubli te tend les bras…"
		"gigawatt_desperation_power2_05" "Gigote…"
		"gigawatt_desperation_power3_01" "Je recharge…"
		"gigawatt_desperation_power3_02" "Il faut que chaque balle compte…"
		"gigawatt_desperation_power3_03" "Je peux encore gagner."
		"gigawatt_desperation_power3_04" "Je me battrai jusqu'à la fin."
		"gigawatt_desperation_power3_05" "Je n'en ai pas fini avec eux."
		"gigawatt_desperation_power4_01" "VOUS ALLEZ TOUS MOURIR !"
		"gigawatt_desperation_power4_02" "VOS VIES SONT PERDUES !"
		"gigawatt_desperation_power4_03" "Je suis votre salut !"
		"gigawatt_desperation_power4_04" "Les cieux s'inclinent devant moi !"
		"gigawatt_desperation_power4_05" "C'est pas encore fini !"
		"gigawatt_enemy_gets_rejuv_01" "Bon sang, ils se sont emparés du réanimateur !"
		"gigawatt_enemy_gets_rejuv_02" "Ils ont le réanimateur. Il nous faut une stratégie."
		"gigawatt_enemy_gets_rejuv_03" "Ils ont le réanimateur, nous devons rester en vie."
		"gigawatt_hunt_01" "Je vais te trouver."
		"gigawatt_hunt_02" "Ils ne pourront pas se cacher éternellement."
		"gigawatt_hunt_03" "Nous les éliminerons un par un."
		"gigawatt_last_one_standing_01" "Bien sûr, tout repose sur moi…"
		"gigawatt_last_one_standing_02" "Je suis l'Oméga, une fois de plus…"
		"gigawatt_last_one_standing_03" "Je ne souhaite pas mourir comme le reste de mon équipe."
		"gigawatt_leave_base_01" "Je retourne au combat."
		"gigawatt_leave_base_02" "Il faut que je retourne au travail."
		"gigawatt_leave_base_03" "J'ai assez attendu."
		"gigawatt_leave_base_04" "Mon équipe a besoin de moi sur le terrain."
		"gigawatt_leave_base_05" "Assez de repos, il est temps de se battre."
		"gigawatt_leaving_area_01" "Pour l'instant, vous allez devoir vous débrouiller."
		"gigawatt_leaving_area_02" "Je reviens quand je peux"
		"gigawatt_leaving_area_03" "Il va falloir survivre sans moi."
		"gigawatt_low_health_warning" "J'ai besoin de soins…"
		"gigawatt_match_start_atlas_gigawatt_convo01_01" "Détective Abrams."
		"gigawatt_match_start_atlas_gigawatt_convo01_03" "En effet. Mais ce que vous tenez me fascine."
		"gigawatt_match_start_atlas_gigawatt_convo01_05" "Ne vous inquiétez pas, Détective. Je ne suis pas stupide."
		"gigawatt_match_start_atlas_gigawatt_convo02_01" "Ce livre vous entraine dans des eaux profondes, Détective. Soyez prudent."
		"gigawatt_match_start_atlas_gigawatt_convo02_03" "Et pourtant, je suis toujours là. Mes conseils doivent bien compter pour quelque chose."
		"gigawatt_match_start_atlas_gigawatt_convo03_02" "J'ai offensé des imbéciles étroits d'esprit à l'ego fragile."
		"gigawatt_match_start_atlas_gigawatt_convo03_04" "Votre naïveté est rafraîchissante, Détective."
		"gigawatt_match_start_bebop_gigawatt_convo01_01" "Ton attachement à celle que tu protèges te rend faible, Bebop."
		"gigawatt_match_start_bebop_gigawatt_convo01_03" "Je suis sûr que c'est une femme charmante. Le fait est que, si tu devenais une menace, je passerais par elle pour t'atteindre."
		"gigawatt_match_start_bebop_gigawatt_convo01_05" "Je suis sûr que tu ne me donneras aucune raison d'aller lui rendre visite."
		"gigawatt_match_start_bebop_gigawatt_convo02_02" "Cher golem de ferraille, je suis différent de tous les hommes que tu as pu rencontrer."
		"gigawatt_match_start_bebop_gigawatt_convo03_02" "Bebop, tu devrais être soulagé, pas méfiant. Grâce à moi, ta précieuse Miss Shelly a une chance de vivre le reste de sa vie agréable, quoique banale."
		"gigawatt_match_start_familiar_gigawatt_convo01_02" "Je sais."
		"gigawatt_match_start_familiar_gigawatt_convo01_04" "Ça se comprend."
		"gigawatt_match_start_familiar_gigawatt_convo02_01" "Tu as un oreiller."
		"gigawatt_match_start_familiar_gigawatt_convo02_03" "Je vois que le Mécène a l'intention de tester ma patience aujourd'hui."
		"gigawatt_match_start_familiar_gigawatt_convo03_01" "Créature, écoute-moi."
		"gigawatt_match_start_familiar_gigawatt_convo03_03" "Très bien. Rem. Écoute-moi. Si le rituel échoue et que tu te retrouves seul, tiens-toi à l'écart de quiconque mentionne l'OSIC."
		"gigawatt_match_start_familiar_gigawatt_convo03_05" "Ils ne t'aideront pas à rentrer chez toi. Crois-moi."
		"gigawatt_match_start_fencer_gigawatt_convo01_02" "Tu fais déjà de la politique, à ce que je vois."
		"gigawatt_match_start_fencer_gigawatt_convo01_04" "Non, tu as une corde que tu as choisi de t'attacher au cou."
		"gigawatt_match_start_fencer_gigawatt_convo02_02" "En effet."
		"gigawatt_match_start_fencer_gigawatt_convo02_04" "J'ai pas le temps de poétiser sur les indignités que j'ai endurées."
		"gigawatt_match_start_fencer_gigawatt_convo02_06" "Silence, gamin."
		"gigawatt_match_start_fencer_gigawatt_convo03_01" "Quand je les aurai rendus inoffensifs, transperce-les."
		"gigawatt_match_start_fencer_gigawatt_convo03_03" "Non, mais la victoire est glorieuse. Et seule la victoire compte aujourd'hui."
		"gigawatt_match_start_gigawatt_ghost_convo01_01" "Je vois que vous prenez enfin votre problème avec le Gardien du serment au sérieux."
		"gigawatt_match_start_gigawatt_ghost_convo01_03" "Je sais que les pactes faustiens finissent rarement bien."
		"gigawatt_match_start_gigawatt_ghost_convo02_02" "Je pense que votre réputation est le cadet de vos soucis."
		"gigawatt_match_start_gigawatt_ghost_convo03_01" "Votre quête de vanité est tout aussi pathétique que clichée."
		"gigawatt_match_start_gigawatt_ghost_convo03_03" "Ton supérieur."
		"gigawatt_match_start_gigawatt_orion_convo01_02" "Heureusement pour toi, ce n'est pas le cas."
		"gigawatt_match_start_gigawatt_orion_convo01_04" "Je suis visionnaire."
		"gigawatt_match_start_gigawatt_orion_convo02_01" "Bonne chance dans ta quête de vengeance… Les faibles d'esprit méritent d'être éliminés."
		"gigawatt_match_start_gigawatt_orion_convo03_02" "On me l'avait jamais faite, celle-là."
		"gigawatt_match_start_gigawatt_orion_convo03_04" "Qu'il est bon d'être apprécié."
		"gigawatt_match_start_gigawatt_viscous_convo01_02" "Non, non, cette chose me parle."
		"gigawatt_match_start_gigawatt_viscous_convo01_04" "Le bien nommé."
		"gigawatt_match_start_gigawatt_viscous_convo01_06" "Dites-moi que c'est un cauchemar."
		"gigawatt_match_start_gigawatt_viscous_convo02_02" "J'aspire à l'apothéose."
		"gigawatt_match_start_gigawatt_viscous_convo02_04" "En effet."
		"gigawatt_match_start_gigawatt_viscous_convo02_06" "Une fois que nous aurons invoqué le Patron, tu le verras par toi-même."
		"gigawatt_match_start_gigawatt_viscous_convo03_01" "Alors comme ça, tu viens des Profondeurs ?"
		"gigawatt_match_start_gigawatt_viscous_convo03_03" "Qu'est-ce qui t'amène ici ?"
		"gigawatt_match_start_gigawatt_viscous_convo03_05" "Tu es un être avec plus de substance que je ne le pensais, Myxo."
		"gigawatt_match_start_necro_gigawatt_convo01_01" "Prends garde, petite…"
		"gigawatt_match_start_necro_gigawatt_convo01_03" "Continue comme ça, et tu ne vivras pas assez longtemps pour finir comme moi."
		"gigawatt_match_start_necro_gigawatt_convo01_05" "Ta survie m'importe peu. Je déteste simplement voir du talent gâché."
		"gigawatt_match_start_necro_gigawatt_convo02_01" "Ne fais pas confiance à ton mentor."
		"gigawatt_match_start_necro_gigawatt_convo02_03" "Non, parce que les mentors enseignent seulement ce qu'ils veulent t'apprendre. Ce sont des lâches qui se servent des jeunes pour trouver une gloire qu'ils ne pourraient pas atteindre tout seuls."
		"gigawatt_match_start_necro_gigawatt_convo02_05" "Bien sûr que non. Elle voit en toi un potentiel qu'elle n'avait plus vu depuis des lustres. Tu es spécial."
		"gigawatt_match_start_necro_gigawatt_convo02_07" "Tu as raison. Qu'est-ce que j'en sais ?"
		"gigawatt_match_start_necro_gigawatt_convo03_02" "Je n'ai jamais dit le contraire."
		"gigawatt_match_start_necro_gigawatt_convo03_04" "Je me fiche de ton âge. Si tu es compétent, tu survivras. Sinon, tu mourras. Dans tous les cas, ce n'est pas mon problème."
		"gigawatt_match_start_unicorn_gigawatt_convo01_01" "Tu caches ta puissance derrière un petit spectacle de cirque, c'est pathétique."
		"gigawatt_match_start_unicorn_gigawatt_convo01_03" "Je me cache des agents fédéraux, je n'essaie pas de régner sur la cour des miracles."
		"gigawatt_match_start_unicorn_gigawatt_convo02_02" "Ne sois pas si dur avec toi-même. La morale des gens s'effondre toujours face à leur intérêt personnel."
		"gigawatt_match_start_unicorn_gigawatt_convo03_02" "Négatif."
		"gigawatt_match_start_unicorn_gigawatt_convo03_04" "LA FERME!"
		"gigawatt_match_start_yamato_gigawatt_convo01_02" "Tout comme toi."
		"gigawatt_match_start_yamato_gigawatt_convo02_01" "Qu'est-ce qui t'a amenée en Amérique ?"
		"gigawatt_match_start_yamato_gigawatt_convo02_03" "Alors tu cherches à te venger ?"
		"gigawatt_match_start_yamato_gigawatt_convo02_05" "Je t'aime bien."
		"gigawatt_match_start_yamato_gigawatt_convo03_02" "Je ne parle pas japonais, mais je reconnais une insulte quand j'en entends une."
		"gigawatt_outnumbered_01" "Ils sont plus nombreux."
		"gigawatt_outnumbered_02" "Ils se déplacent en groupe."
		"gigawatt_outnumbered_03" "Ce serait imprudent de les affronter seul."
		"gigawatt_ping_affermative_01" "Oui."
		"gigawatt_ping_affermative_03" "Ça me convient."
		"gigawatt_ping_blue_help_01" "Besoin d'aide sur la bleue !"
		"gigawatt_ping_blue_help_02" "Besoin d'aide sur Broadway !"
		"gigawatt_ping_defend_blue_01" "Défendez la voie bleue."
		"gigawatt_ping_defend_blue_02" "Défendez Broadway."
		"gigawatt_ping_defend_green_01" "Défendez la verte"
		"gigawatt_ping_defend_green_02" "Défendez Greenwich."
		"gigawatt_ping_defend_yellow_01" "Défendez la voie jaune."
		"gigawatt_ping_defend_yellow_02" "Défendez York."
		"gigawatt_ping_good_game_03" "Vous vous êtes bien battus."
		"gigawatt_ping_good_job_01" "Bravo."
		"gigawatt_ping_green_help_01" "Besoin d'aide sur la verte !"
		"gigawatt_ping_green_help_02" "Besoin d'aide sur Greenwich !"
		"gigawatt_ping_headed_blue_01" "Je vais vers la bleue."
		"gigawatt_ping_headed_blue_02" "Je vais vers Broadway."
		"gigawatt_ping_headed_green_01" "Je vais vers la verte."
		"gigawatt_ping_headed_green_02" "Je vais vers Greenwich."
		"gigawatt_ping_headed_yellow_01" "Je vais vers la jaune."
		"gigawatt_ping_headed_yellow_02" "Je vais vers York."
		"gigawatt_ping_lets_go_blue" "Allons vers la bleue !"
		"gigawatt_ping_lets_go_blue_alt" "Allons vers Broadway !"
		"gigawatt_ping_lets_go_green" "Allons vers la verte !"
		"gigawatt_ping_lets_go_green_alt" "Allons vers Greenwich !"
		"gigawatt_ping_lets_go_yellow" "Allons vers la jaune !"
		"gigawatt_ping_lets_go_yellow_alt" "Allons vers York !"
		"gigawatt_ping_need_help_blue" "Besoin d'aide sur la bleue !"
		"gigawatt_ping_need_help_blue_alt" "J'ai besoin d'aide sur Broadway !"
		"gigawatt_ping_need_help_green" "J'ai besoin d'aide sur la voie verte !"
		"gigawatt_ping_need_help_green_alt" "Besoin d'aide sur Greenwich !"
		"gigawatt_ping_need_help_yellow" "Besoin d'aide sur la jaune !"
		"gigawatt_ping_need_help_yellow_alt" "J'ai besoin d'aide sur York !"
		"gigawatt_ping_nevermind_01" "Oubliez ça."
		"gigawatt_ping_nevermind_02" "J'ai rien dit."
		"gigawatt_ping_nevermind_03" "J'ai parlé trop vite."
		"gigawatt_ping_pre_game_01" "Aujourd'hui, nous invoquons un dieu."
		"gigawatt_ping_pre_game_02" "Personne ne m'empêchera d'obtenir ce qui m'est dû."
		"gigawatt_ping_pre_game_03" "La grandeur peut être entravée, mais elle ne peut jamais être arrêtée."
		"gigawatt_ping_pre_game_04" "Je n'en peux plus de bouder dans le noir."
		"gigawatt_ping_pre_game_05" "Je ne connais ni peur ni limites."
		"gigawatt_ping_pre_game_06" "Leur souffrance est aussi insignifiante qu'inévitable."
		"gigawatt_ping_push_blue_01" "On push la bleue."
		"gigawatt_ping_push_blue_02" "On push Broadway."
		"gigawatt_ping_push_green_01" "On push la verte."
		"gigawatt_ping_push_green_02" "On push Greenwich."
		"gigawatt_ping_push_yellow_01" "On push la jaune."
		"gigawatt_ping_push_yellow_02" "On push York."
		"gigawatt_ping_thank_you_01" "Merci."
		"gigawatt_ping_welcome" "De rien."
		"gigawatt_ping_yellow_help_01" "Besoin d'aide sur la jaune !"
		"gigawatt_ping_yellow_help_02" "Besoin d'aide sur York !"
		"gigawatt_select_01" "Vous avez donc fait appel à moi."
		"gigawatt_select_02" "Mon aide a un prix."
		"gigawatt_select_03" "Je n'ai pas d'égal."
		"gigawatt_select_04" "Je ne suis le pion de personne."
		"gigawatt_select_05" "Ma réputation parle d'elle-même."
		"gigawatt_select_06" "De ces mains, je détruirai, et de ces mêmes mains, je reconstruirai."
		"gigawatt_select_07" "Ce ne sont que des affaires, rien de plus…"
		"gigawatt_select_08" "Ils se sont fait le mauvais ennemi."
		"gigawatt_select_09" "Cette ville me convient… et elle sera mienne."
		"gigawatt_select_10" "Je me suis libéré des chaînes du passé… et mon avenir s'annonce radieux."
		"gigawatt_t1_shop_reminder_01" "Il faut que je pense à améliorer mon équipement."
		"gigawatt_t1_shop_reminder_02" "C'est peut-être le moment de faire quelques achats."
		"gigawatt_t1_shop_reminder_03" "Il faut que je trouve le temps de passer à la boutique."
		"gigawatt_t2_shop_reminder_01" "Il faut que j'achète une relique."
		"gigawatt_t2_shop_reminder_02" "Je devrais peut-être voir ce que je peux acheter."
		"gigawatt_t2_shop_reminder_03" "Je me demande si le magasin a ce dont j'ai besoin."
		"gigawatt_t3_shop_reminder_01" "J'ai besoin d'améliorer mon équipement."
		"gigawatt_t3_shop_reminder_02" "Je peux m'acheter un nouvel objet à la boutique."
		"gigawatt_t3_shop_reminder_03" "Ce serait du gâchis de ne pas dépenser ces âmes."
		"gigawatt_t4_shop_reminder_01" "Je peux acheter ce qui me plait."
		"gigawatt_t4_shop_reminder_02" "Je devrais me rendre au cabinet de curiosités…"
		"gigawatt_t4_shop_reminder_03" "Le bon achat peut sceller notre victoire."
		"gigawatt_unselect_01" "Très bien. Si vous ne voulez pas gagner, c'est votre affaire."
		"gigawatt_unselect_02" "Bien. Ça me laisse plus de temps pour élaborer mes plans."
		"gigawatt_unselect_03" "Vous pensez ne pas avoir besoin de moi ? Allons donc."
		"gigawatt_unselect_04" "Vous reviendrez."
		"gigawatt_unselect_05" "J'ai de toute façon un empire naissant à diriger…"
		"gigawatt_unselect_06" "Un jour, vous aurez besoin de moi… et je vous regarderai me supplier de vous aider."
		"gigawatt_unselect_07" "C'est vrai, je suis intimidant."
		"gigawatt_unselect_08" "Quand vous voudrez la victoire, je serai prêt."
		"gigawatt_unselect_09" "Un jour, vous échouerez… et ce jour-là, souvenez-vous de cet instant. Celui où vous auriez pu choisir la victoire."
		"gigawatt_unselect_10" "C'est adorable de croire que vous n'avez pas besoin de moi."
		"gigawatt_use_power1_01" "Foudre"
		"gigawatt_use_power1_02" "Gare à la foudre !"
		"gigawatt_use_power1_03" "Je lance la foudre !"
		"gigawatt_use_power1_04" "Les puissants chuteront."
		"gigawatt_use_power1_05" "Je vais m'en débarrasser."
		"gigawatt_use_power1_06" "Nous sommes implacables !"
		"gigawatt_use_power1_07" "Canalisation de la foudre…"
		"gigawatt_use_power1_08" "La puissance coule dans mes veines."
		"magician_henry_respawn_01" "Je prends le relai."
		"magician_henry_respawn_02" "Écarte-toi, Savannah."
		"magician_henry_respawn_03" "Savannah, laisse-moi te montrer comment on fait."
		"magician_henry_respawn_04" "Sans Savannah pour me faire tuer, c'est une autre paire de manches, vous allez voir."
		"magician_henry_respawn_05" "Je vais réparer les erreurs de Savannah."
		"magician_henry_respawn_06" "Bien sûr, Savannah veut que j'arrange les choses."
		"magician_henry_respawn_07" "On dira que c'est ma faute."
		"magician_henry_respawn_08" "Prends-en de la graine, Savannah."
		"magician_henry_respawn_09" "Installe-toi confortablement et profite du spectacle Savannah, tu n'auras plus le premier rôle de sitôt."
		"magician_henry_respawn_10" "Henry le Magnifique reprend les rênes !"
		"magician_henry_select_01" "J'ai hâte d'en finir avec toi. (Ouais, le sentiment est réciproque, mon pote.)"
		"magician_henry_select_02" "Le Magnifique Henry est prêt à vous aider. (Pff.)"
		"magician_henry_select_02_a" "Il y a quelque chose de drôle ?"
		"magician_henry_select_03" "(Permettez-nous de vous rendre service.) Nous ? C'est moi qui vais faire 90 % du travail ! (La ferme.)"
		"magician_henry_select_04" "On sera prêts à aider dès qu'on se sera mis d'accord sur qui contrôle le corps. (Moi.)"
		"magician_henry_select_04_a" "Non, pas elle."
		"magician_henry_select_05" "(On peut faire semblant de s'apprécier pendant 60 minutes, s'il te plaît ?) Je vais être optimiste et dire oui."
		"magician_henry_select_06" "Vous allez assister à mon plus grand tour de magie."
		"magician_henry_select_06_a" "Va au diable, Savannah."
		"magician_henry_select_07" "(Vous allez voir quelque chose que vous n'avez jamais vu de votre vie.) Oh, tu vas dire « s'il te plaît » ou « merci » ?"
		"magician_henry_select_08" "Le malheur n'aime pas la compagnie, c'est la compagnie qui est un malheur. (Tu devrais refaire cette réplique, mais en étant vraiment drôle, cette fois.)"
		"magician_henry_select_08_a" "Madame, si vous voulez la dire, je vous en prie."
		"magician_henry_select_09" "Je dirais qu'on va faire de notre mieux, mais Savannah ne donne jamais plus de 35 %."
		"magician_henry_select_09_a" "C'est ce que j'ai dit."
		"magician_henry_select_10" "(Vous ne voulez pas laisser Henry contrôler le corps, il prend des décisions catastrophiques.) Évidemment. Je t'ai épousée."
		"magician_henry_use_power1_01" "Éclair éphémère !"
		"magician_henry_use_power1_02" "Je m'en charge…"
		"magician_henry_use_power1_03" "Ne lâchez pas l'éclair des yeux."
		"magician_henry_use_power1_04" "Faites attention à où cela atterrit."
		"magician_henry_use_power1_05" "Il suffit d'une fraction de seconde."
		"magician_henry_use_power1_06" "Ça va les tenir en alerte."
		"magician_henry_use_power1_07" "Bonne chance pour t'en sortir !"
		"magician_henry_use_power1_08" "Place à la diversion."
		"magician_henry_use_power1_09" "Lancer de boulon !"
		"magician_henry_use_power1_10" "Bingo !"
		"magician_henry_use_power2_01" "Savannah, j'ai besoin de ton aide !"
		"magician_henry_use_power2_02" "Voici ma charmante assistante."
		"magician_henry_use_power2_03" "Je vous présente la spectaculaire Savannah."
		"magician_henry_use_power2_04" "Veuillez souhaiter la bienvenue à mon adorable assistante."
		"magician_henry_use_power2_05" "Ne fiche pas tout en l'air, Savannah."
		"magician_henry_use_power2_06" "Allez, au boulot Savannah."
		"magician_henry_use_power2_07" "Comme au bon vieux temps, Savannah."
		"magician_henry_use_power2_08" "Je compte sur toi, Savannah."
		"magician_henry_use_power2_09" "Où est passée mon assistante…"
		"magician_henry_use_power2_10" "Savannah !"
		"magician_henry_use_power3_01" "Aracadabra !"
		"magician_henry_use_power3_02" "Allez-y !"
		"magician_henry_use_power3_03" "Prêt pour un tour de magie ?"
		"magician_henry_use_power3_04" "Je suis vraiment doué…"
		"magician_henry_use_power3_05" "Pas de panique, c'est temporaire."
		"magician_henry_use_power3_06" "Mon tour préféré."
		"magician_henry_use_power3_07" "La magie transforme les gens."
		"magician_henry_use_power3_08" "Tu feras un super lapin."
		"magician_henry_use_power3_09" "Tu vas être adorable."
		"magician_henry_use_power3_10" "Voici un tour spécial rien que pour toi."
		"magician_henry_use_power4_01" "Venons-en maintenant au bouquet final."
		"magician_henry_use_power4_02" "Ça fait toujours un tabac."
		"magician_henry_use_power4_03" "C'est l'heure du prestige…"
		"magician_henry_use_power4_04" "Oh, ils réclament un rappel ?"
		"magician_henry_use_power4_05" "Vous n'en croirez pas vos yeux."
		"magician_henry_use_power4_06" "Veuillez retenir vos applaudissements."
		"magician_henry_use_power4_07" "JE SUIS HENRY LE MAGNIFIQUE."
		"magician_henry_use_power4_08" "Personne ne me vole la vedette !"
		"magician_henry_use_power4_09" "Voici un tour que vous n'êtes pas près d'oublier."
		"magician_henry_use_power4_10" "Voyons voir ce que Savannah va faire."
		"punkgoat_match_start_punkgoat_ghost_convo02_01" "Quand ta tour d'ivoire s'écroulera, j'espère que tu seras dessous."
		"punkgoat_match_start_punkgoat_orion_convo01_01" "Ils ont un groupe de tueurs entraînés et nous, un type avec une hanche foutue et déjà un pied dans la tombe. Très équilibré."
		"punkgoat_match_start_punkgoat_orion_convo01_03" "En gros, on est cinq contre six. Le Patron doit nous détester."
		"punkgoat_match_start_punkgoat_tengu_convo01_01" "Oh, regardez qui voilà : le panneau publicitaire ambulant de Carlos Arroyo pour sa campagne municipale."
		"punkgoat_match_start_punkgoat_tengu_convo01_03" "Ouais, ouais, on connaît tous cette histoire idiote. Madame, il s'est servi de toi pour faire grimper l'immobilier à Spanish Harlem, et maintenant il se sert de toi pour entrer à la mairie."
		"punkgoat_match_start_punkgoat_tengu_convo03_02" "Si tu me demandes comment j'ai eu la tête de chèvre, je te défonce le crâne."
	}
}
